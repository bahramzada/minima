# Supabase — Project Settings > API / Connect
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenRouter — server-only, never prefix with NEXT_PUBLIC_
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-4b-it
OPENROUTER_SITE_URL=http://localhost:3000

# App settings
APP_TIMEZONE=Asia/Baku

# Optional: allow anonymous OpenRouter calls while Supabase is not configured.
# Leave false in public deployments to protect the API key.
ALLOW_DEMO_AI=false
